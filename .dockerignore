.git
.github

# Python
.venv
venv
__pycache__
**/__pycache__
*.pyc

# Node
opc/plugins/office_ui/frontend_src/node_modules
opc/plugins/office_ui/frontend_src/dist

# Secrets — .env is NOT read by OpenOPC and must never land in an image layer.
.env
.env.*

# Local runtime state — never bake secrets or per-machine DB state into the
# image. Everything here is bind-mounted from the host at runtime by
# docker-compose.yml, or regenerated by docker-entrypoint.sh.
.opc/global.db
.opc/global.db-shm
.opc/global.db-wal
.opc/ui_state.db
.opc/logs
.opc/memory
.opc/projects
.opc/config/*.yaml
.opc/agent_homes
.opc/bin
.opc-comms

# Workplace output (deliverables), local test artifacts
/OpenOPC_workplace
/*_workplace
.pytest_cache
